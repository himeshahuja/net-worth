# Copy this file to .env and fill it in. .env is gitignored and never leaves this computer.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
# The secret for the environment below: Plaid gives sandbox and production different secrets.
PLAID_SECRET=

# sandbox: Plaid's test banks (sign in with user_good / pass_good).
# production: your real accounts (the free Trial plan allows 10 connections).
PLAID_ENV=sandbox

# Each snapshot is dated by this time zone.
SNAPSHOT_TZ=America/New_York

# The page's password. Every snapshot encrypts the published figures with it, and visitors type it to see them.
# At least 12 characters; a few unrelated words strung together is best. `npm run secrets` gives it to the Action.
NETWORTH_PASSWORD=
# Only while changing the password: the old one, so the next snapshot can open the saved history. Remove it after.
NETWORTH_PREVIOUS_PASSWORD=
